      propertyPath: m_text
      value: "\u2022 Walk on a building only if it has <color=orange>orange ground</color>.\r\n\u2022
        No orange = you cannot stand on it.\r\n\u2022 A <color=#555555>darker shadow</color>
        means it is away from you\u2014walk right through it!"
      objectReference: {fileID: 0}
